# Copy to .env.local (git-ignored) and fill in. Rebuild the app after changing.
# The key is bundled into the app: restrict it to the Generative Language API,
# set a budget cap, and rotate it after testing.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional, defaults to gemini-3.1-flash-lite
EXPO_PUBLIC_GEMINI_MODEL=
# Optional, defaults to https://shadowcodes.in/JRS/api/Card
EXPO_PUBLIC_API_URL=
# Optional, dev only: Mac's LAN IP for Reactotron if auto-detect fails
EXPO_PUBLIC_REACTOTRON_HOST=
