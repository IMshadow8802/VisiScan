{
  "expo": {
    "name": "VisiScan",
    "slug": "visiscan",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "visiscan",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.prdinfotech.visiscan",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VisiScan uses the camera to scan visiting cards.",
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "appleTeamId": "K3T9Y3AW7F"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prdinfotech.visiscan",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "react-native-document-scanner-plugin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "VisiScan uses the camera to scan visiting cards.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
